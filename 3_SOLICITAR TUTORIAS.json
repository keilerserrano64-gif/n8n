        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Nueva Tutoría Asignada</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      background-color: #f4f6f9;\n      margin: 0;\n      padding: 20px;\n    }\n    .container {\n      background-color: #ffffff;\n      border-top: 4px solid #0056b3;\n      padding: 24px;\n      border-radius: 6px;\n      box-shadow: 0 2px 5px rgba(0,0,0,0.08);\n      max-width: 500px;\n      margin: 0 auto;\n    }\n    h2 {\n      margin-top: 0;\n      color: #1a252f;\n      font-size: 1.25rem;\n    }\n    .info-list {\n      margin: 20px 0;\n      padding: 0;\n      list-style-type: none;\n    }\n    .info-list li {\n      padding: 8px 0;\n      border-bottom: 1px solid #edf2f7;\n      color: #4a5568;\n    }\n    .info-list li strong {\n      color: #2d3748;\n    }\n    .callout {\n      background-color: #ebf8ff;\n      border-left: 3px solid #3182ce;\n      padding: 12px;\n      margin-top: 20px;\n      border-radius: 4px;\n      color: #2b6cb0;\n      font-size: 0.95rem;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"container\">\n    <h2>📚 Se te ha asignado una nueva tutoría</h2>\n    \n    <ul class=\"info-list\">\n      <li><strong>Materia:</strong> {{$('Code - Emparejar Tutor y Bloque').first().json.materia}}</li>\n      <li><strong>Fecha y hora:</strong> {{$('Code - Emparejar Tutor y Bloque').first().json.fecha_hora}}</li>\n      <li><strong>Estudiante (Telegram ID):</strong> {{$('Entrada').first().json.chat_id}}</li>\n    </ul>\n\n    <div class=\"callout\">\n      ✉️ Por favor confirma tu disponibilidad respondiendo a este correo.\n    </div>\n  </div>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
