        "jsCode": "const idTutor = String($('Code - Extraer ID Tutor').first().json.id_tutor || '').trim();\nconst bloques = $input.all().map(i => i.json);\n\nconst libres = bloques.filter(b =>\n  String(b.id_tutor || '').trim() === idTutor &&\n  String(b.estado || '').trim().toUpperCase() === 'LIBRE'\n);\n\nconst fechas = libres.map(b => b.fecha_hora).filter(Boolean);\nconst lista = fechas.map((f, idx) => `${idx + 1}. ${f}`).join('\\n');\n\nreturn [{\n  json: {\n    ...$('Code - Extraer ID Tutor').first().json,\n    fechas_disponibles: fechas,\n    lista_fechas: lista || 'No hay bloques libres registrados por ahora.'\n  }\n}];"
      },
