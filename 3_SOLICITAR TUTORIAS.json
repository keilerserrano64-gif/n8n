    {
      "parameters": {
        "jsCode": "const val = $('Code - Validar Resultado NLP').first().json;\nconst materiaVal = String(val.materia || '').trim().toLowerCase();\nconst fechaIso = String(val.fecha_iso || '').trim();\nconst chatId = $('Entrada').first().json.chat_id;\n\nconst todosLosTutores = $('Sheets - Obtener Tutores por Materia').all().map(i => i.json);\n\nlet tutores = todosLosTutores.filter(t => String(t.materia || '').trim().toLowerCase() === materiaVal);\n\nif (tutores.length === 0 && todosLosTutores.length > 0) {\n  tutores = todosLosTutores;\n}\n\nconst idsTutores = tutores.map(t => String(t.id_tutor || '').trim());\n\nconst bloques = $('Sheets - Cruzar Disponibilidad').all()\n  .map(i => i.json)\n  .filter(b =>\n    String(b.estado || '').trim().toUpperCase() === 'LIBRE' &&\n    idsTutores.includes(String(b.id_tutor || '').trim())\n  );\n\nconst normalizarFecha = (f) => String(f || '').trim().replace(' ', 'T').slice(0, 16);\n\n// Solo se acepta si hay coincidencia EXACTA de fecha y hora\nconst elegido = bloques.find(b => normalizarFecha(b.fecha_hora) === normalizarFecha(fechaIso));\n\nif (!elegido) {\n  return [{\n    json: {\n      chat_id: chatId,\n      materia: val.materia || '',\n      id_bloque: '',\n      id_tutor: '',\n      fecha_hora: '',\n      email_tutor: '',\n      asignado: false\n    }\n  }];\n}\n\nconst tutor = tutores.find(t => String(t.id_tutor || '').trim() === String(elegido.id_tutor || '').trim()) || {};\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    materia: tutor.materia || val.materia || '',\n    id_bloque: elegido.id_bloque || '',\n    id_tutor: elegido.id_tutor || '',\n    fecha_hora: elegido.fecha_hora || '',\n    email_tutor: tutor.email_tutor || '',\n    asignado: true\n  }\n}];"
      },
