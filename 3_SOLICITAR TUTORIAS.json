    {
      "parameters": {
        "jsCode": "// 1. Extraemos la lista de materias traídas dinámicamente desde Google Sheets\nconst materiasSheets = $(\"Sheets - Obtener Materias Disponibles1\").all();\nconst materias = materiasSheets.map(item => item.json.materia).filter(Boolean);\n\n// 2. Extraemos la entrada que escribió el usuario desde el nodo Switch / Entrada\nconst entradaUsuario = $(\"Switch - Paso del Wizard\").first().json.text_raw || \"\";\nlet input = String(entradaUsuario).trim();\n\nlet materiaSeleccionada = null;\nlet isValid = false;\n\n// 3. Validación por número de opción (1, 2, 3...)\nif (!isNaN(input) && Number.isInteger(parseFloat(input))) {\n  let index = parseInt(input) - 1;\n  if (index >= 0 && index < materias.length) {\n    materiaSeleccionada = materias[index];\n    isValid = true;\n  }\n} else {\n  // 4. Validación por texto (coincidencia de nombre)\n  let match = materias.find(m => m.toLowerCase() === input.toLowerCase());\n  if (match) {\n    materiaSeleccionada = match;\n    isValid = true;\n  }\n}\n\n// 5. Retornamos los datos limpios para el flujo\nreturn {\n  json: {\n    ...$(\"Switch - Paso del Wizard\").first().json,\n    materia_seleccionada: materiaSeleccionada,\n    es_materia_valida: isValid,\n    lista_materias: materias\n  }\n};"
      },
