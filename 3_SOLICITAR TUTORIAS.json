      "parameters": {
        "jsCode": "const materias = [...new Set(items.map(i => i.json.materia).filter(Boolean))];\nconst lista = materias.map((m, idx) => `${idx + 1}. ${m}`).join('\\n');\nreturn [{ json: { chat_id: $('Entrada').first().json.chat_id, lista_materias: lista } }];"
      },
