    {
      "parameters": {
        "jsCode": "let rawText = '';\nif ($json.content?.parts?.[0]?.text) {\n  rawText = $json.content.parts[0].text;\n} else if (typeof $json.text === 'string') {\n  rawText = $json.text;\n} else if (typeof $json.message === 'string') {\n  rawText = $json.message;\n} else {\n  rawText = JSON.stringify($json);\n}\n\nlet parsed = {};\ntry {\n  const clean = rawText.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { valido: false };\n}\n\nconst sessionCtx = $('Entrada').first().json.contexto || '{}';\nlet ctx = {};\ntry {\n  ctx = typeof sessionCtx === 'string' ? JSON.parse(sessionCtx) : sessionCtx;\n} catch (e) {}\n\nreturn [{\n  json: {\n    chat_id: $('Entrada').first().json.chat_id,\n    materia: ctx.materia || '',\n    fecha_iso: parsed.fecha_iso || '',\n    valido: Boolean(parsed.valido) && Boolean(parsed.fecha_iso)\n  }\n}];"
      },
