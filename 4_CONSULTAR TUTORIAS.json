      "parameters": {
        "jsCode": "const rows = items.filter(i => i.json && Object.keys(i.json).length > 0 && i.json.id_tutoria);\nconst chatId = $('Entrada').first().json.chat_id;\nif (rows.length === 0) {\n  return [{ json: { chat_id: chatId, mensaje: 'No tienes tutorías activas registradas.' } }];\n}\nconst lista = rows.map(i => `🆔 ${i.json.id_tutoria} | 📘 ${i.json.materia} | 🗓️ ${i.json.fecha_hora}`).join('\\n');\nreturn [{ json: { chat_id: chatId, mensaje: `Tus tutorías activas:\\n${lista}` } }];"
